<?php $this->useLayout($layout ?? 'dpress:layout') ?>
<?php $this->startBlock('content') ?>
    <h1><?= esc_html($heading ?? $site_name) ?></h1>
    <?php if (empty($posts)): ?>
        <p>Nothing published yet.</p>
    <?php else: ?>
        <?php foreach ($posts as $post): ?>
            <article class="post-summary">
                <?php // the post's picture, if it has one. `$thumbnails` is keyed by content id
                      // and cost one query for the whole page - see `thumbnails()` ?>
                <?php // `aria-hidden` and an empty `alt` because this link and the title below it
                      // go to the same post: announced twice it is noise, and an image link with
                      // no accessible name is worse than one that is skipped ?>
                <?php if (isset($thumbnails[$post['id']])): ?>
                    <a class="post-thumbnail" tabindex="-1" aria-hidden="true"
                       href="<?= esc_attr(route_url($post_path.$post['slug'])) ?>"><?=
                        $mediaView->tag($thumbnails[$post['id']], 'medium', ['alt' => ''])
                    ?></a>
                <?php endif ?>
                <h2><a href="<?= esc_attr(route_url($post_path.$post['slug'])) ?>"><?= esc_html($post['title']) ?></a></h2>
                <p class="meta">
                    <?php if (isset($authors[$post['id']])): ?>
                        by <?= esc_html($authors[$post['id']]) ?> &mdash;
                    <?php endif ?>
                    <?= $dates->tag($post['published_at']) ?>
                </p>
                <?= $post['lead_html'] ?>
            </article>
        <?php endforeach ?>
    <?php endif ?>
<?php $this->endBlock() ?>
