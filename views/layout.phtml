<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><?= esc_html(($title ?? '').($title ?? '' ? ' – ' : '').($site_name ?? '')) ?></title>
    <?php if (!empty($site_icon)): ?>
        <link rel="icon" href="<?= esc_attr($site_icon) ?>">
        <link rel="apple-touch-icon" href="<?= esc_attr($site_icon) ?>">
    <?php endif ?>
    <style>
        :root {
            color-scheme: light dark;
            /* every link that is a link rather than chrome. One value per scheme, because a
               pink that reads well on near-black is faint on white and the reverse - these are
               5.2:1 here and 7.5:1 in the dark block, past WCAG AA and AAA respectively. */
            --link: #d4006b;
            /* the four panels. One value each: the border is it at full strength and the
               background is the same colour at a tenth, so a panel is always in key with itself */
            --quote: #71717a;
            --info: #2563eb;
            --warning: #d97706;
            --danger: #dc2626;
        }
        * { box-sizing: border-box; }
        body { margin: 0; font: 15px/1.6 -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
               background: #f4f4f5; color: #18181b; }
        /* `:visited` needs saying separately every time - it is the more specific match, and
           would otherwise keep the browser's purple whatever `a` said. The header and the menu
           still set their own, because a link on a dark bar is chrome rather than a link. */
        a, a:visited { color: var(--link); }
        header { background: #18181b; color: #fafafa; padding: 14px 20px; display: flex; gap: 16px; align-items: center; }
        header a { color: #fafafa; text-decoration: none; }
        header .brand { display: flex; align-items: center; }
        header .logo { height: 26px; width: auto; display: block; }
        header .spacer { flex: 1; }
        /* a block in the header is beside the menu rather than a card of its own: the sidebar's
           panel styling is the sidebar's, and a white box in a black bar is not what anybody
           putting something up here meant */
        header .block { font-size: 13px; }
        header .block-title { display: inline; font-size: 13px; margin: 0 6px 0 0;
                              text-transform: none; letter-spacing: 0; color: inherit; opacity: .7; }
        header .tag-cloud { display: inline-flex; }
        header form { margin: 0; }
        header button { background: none; border: 1px solid #52525b; color: #fafafa; border-radius: 6px;
                        padding: 5px 10px; cursor: pointer; font: inherit; }
        main { max-width: 460px; margin: 40px auto; padding: 0 16px; }
        .card { background: #fff; border-radius: 10px; padding: 28px; }
        h1 { font-size: 20px; margin: 0 0 20px; }
        .form-field { margin-bottom: 16px; }
        .form-field label { display: block; font-weight: 600; font-size: 13px; margin-bottom: 5px; }
        .form-required { color: #dc2626; }
        input[type=text], input[type=password] { width: 100%; padding: 9px 11px; border: 1px solid #d4d4d8;
                                                 border-radius: 6px; font: inherit; background: #fff; color: inherit; }
        .form-error { color: #dc2626; display: block; margin-top: 4px; font-size: 13px; }
        .form-description { color: #71717a; display: block; margin-top: 4px; font-size: 13px; }
        .form-errors { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; border-radius: 6px;
                       padding: 10px 14px; margin: 0 0 18px; list-style: none; }
        .notice { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; border-radius: 6px;
                  padding: 10px 14px; margin: 0 0 18px; }
        button.primary { background: #18181b; color: #fff; border: 0; border-radius: 6px; padding: 10px 18px;
                         font: inherit; font-weight: 600; cursor: pointer; }
        .links { margin-top: 18px; font-size: 14px; }
        .menu { list-style: none; display: flex; gap: 14px; margin: 0; padding: 0; }
        .menu a { font-size: 14px; opacity: .85; }
        .menu .menu { display: none; }
        .breadcrumb { font-size: 13px; color: #71717a; margin-bottom: 14px; }
        .breadcrumb a, .breadcrumb a:visited { color: var(--link); }
        main.wide { max-width: 720px; }
        /* The content column keeps the width it always had and the sidebar is added beside it, so
           putting a block in a place does not reflow the reading column. `minmax(0, 1fr)` rather
           than `1fr`, or a wide code block inside the content stretches the grid track and pushes
           the sidebar off the page instead of scrolling inside itself. */
        main.has-sidebar { max-width: 1020px; display: grid; align-items: start; gap: 24px;
                           grid-template-columns: minmax(0, 1fr) 252px; }
        .sidebar .block { background: #fff; border-radius: 10px; padding: 18px 20px; margin-bottom: 16px; }
        .sidebar .block:last-child { margin-bottom: 0; }
        .block-title { font-size: 14px; text-transform: uppercase; letter-spacing: .04em;
                       color: #71717a; margin: 0 0 10px; }
        .block > :last-child { margin-bottom: 0; }
        .block img { border-radius: 8px; }
        .block .menu { flex-direction: column; gap: 6px; }
        .category-list { list-style: none; margin: 0; padding: 0; font-size: 14px; }
        .category-list .category-list { padding-left: 14px; }
        .category-list li { padding: 3px 0; }
        .tag-cloud { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px; }
        /* five buckets, and the block decides which one a tag is in - what "used a lot" looks
           like is the stylesheet's business, which is why no font size is written into the HTML */
        .tag-cloud .tag-1 { font-size: 12px; }
        .tag-cloud .tag-2 { font-size: 13px; }
        .tag-cloud .tag-3 { font-size: 14px; }
        .tag-cloud .tag-4 { font-size: 16px; }
        .tag-cloud .tag-5 { font-size: 18px; }
        /* Under the width where two columns stop being two columns, the sidebar goes below the
           content rather than beside it - which is also the order it is in the document. */
        @media (max-width: 900px) {
            main.has-sidebar { grid-template-columns: minmax(0, 1fr); }
        }
        .post-summary { padding-bottom: 20px; margin-bottom: 20px; border-bottom: 1px solid #e4e4e7; }
        .post-summary:last-child { border-bottom: 0; margin-bottom: 0; padding-bottom: 0; }
        .post-summary h2 { font-size: 18px; margin: 0 0 4px; }
        .post-summary h2 a { color: inherit; text-decoration: none; }
        .meta { color: #71717a; font-size: 13px; margin: 0 0 10px; }
        .meta a, .meta a:visited { color: var(--link); }
        /* Nothing an author puts in a document may be wider than the column it is in. A photo
           straight off a phone is four thousand pixels across, and a video is 1920 whatever the
           column is; without this either of them decides how wide the page is. `height: auto`
           keeps the shape, and `max-width` rather than `width` so a small one stays its own size
           instead of being blown up to fill. */
        img, video { max-width: 100%; height: auto; }
        /* an iframe has no intrinsic shape, so it needs one told to it rather than kept */
        .dpress-embed { width: 100%; aspect-ratio: 16 / 9; height: auto; border: 0; display: block; }
        .featured img { border-radius: 8px; }
        .tags { margin-top: 20px; }
        /* `:visited` stated as well, and it has to be: `a:visited` is (0,1,1) and `.tag` alone is
           (0,1,0), so the link colour won on every tag somebody had already been to - a cloud
           where half the pills are pink for a reason that is nobody's business. A pill is chrome,
           like the header links, rather than a link in prose. */
        .tag, .tag:visited { display: inline-block; background: #f4f4f5; border-radius: 999px;
               padding: 3px 11px; font-size: 13px; text-decoration: none; color: #3f3f46;
               margin: 0 4px 4px 0; }
        .attachments-title { font-size: 15px; margin: 24px 0 8px; }
        .attachments { list-style: none; padding: 0; margin: 0; }
        .attachments li { display: flex; align-items: center; gap: 10px; padding: 6px 0; }
        .attachment-icon svg { width: 24px; height: 24px; color: #71717a; display: block; }
        /* A scale for the headings a document contains, scoped to `article` so the 20px `h1` on a
           login or a form card is left alone.
           Without this a `##` had no rule and fell to the browser's `1.5em` - about 22.5px, which
           is *larger* than the title above it, so every post read as though it began in the
           middle. The title is the biggest thing on the page, and what an author writes inside it
           steps down from there. */
        article h1 { font-size: 28px; margin: 0 0 18px; }
        article h2 { font-size: 21px; margin: 28px 0 10px; }
        article h3 { font-size: 17px; margin: 22px 0 8px; }
        /* A blockquote, and the three panels `> [!WARNING]` and friends turn one into.
           The margin is reset: a browser indents a blockquote 40px on the left, which would leave
           the rule floating in the gutter rather than marking the column. `padding-right` is for
           the icon, which is absolutely positioned and would otherwise have text run under it.
           `color-mix` keeps one colour per panel - the border at full strength, the background at
           a tenth of it - so a panel is always in key with itself and adding a fourth is one line. */
        blockquote, .callout {
            position: relative; margin: 18px 0; padding: .5em 3.2em .5em 1em;
            border-left: 4px solid var(--quote);
            background: color-mix(in srgb, var(--quote) 10%, transparent);
        }
        .callout-info    { border-left-color: var(--info);
                           background: color-mix(in srgb, var(--info) 10%, transparent); }
        .callout-warning { border-left-color: var(--warning);
                           background: color-mix(in srgb, var(--warning) 10%, transparent); }
        .callout-danger  { border-left-color: var(--danger);
                           background: color-mix(in srgb, var(--danger) 10%, transparent); }
        /* The icon is a background image rather than an `<svg>` in the document, for the reason
           the syntax highlighting keeps its colours out of `body_html`: an icon is presentation,
           and presentation in stored content means re-rendering every post to change it. */
        blockquote::after, .callout::after {
            content: ''; position: absolute; top: .6em; right: .8em;
            width: 22px; height: 22px; opacity: .55;
            background-repeat: no-repeat; background-size: contain;
        }
        /* stroked like the other three rather than solid: at .55 a filled grey glyph on a dark
           background loses far more of itself than a 2px line does, and the quote mark read as
           faint next to icons drawn the same size */
        blockquote::after, .callout-quote::after {
            background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="%2371717a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 12H6a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v6c0 2.3-1.3 3.7-3.2 4.3"/><path d="M19 12h-4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v6c0 2.3-1.3 3.7-3.2 4.3"/></svg>');
        }
        .callout-info::after {
            background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="%232563eb" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 7.6v.1"/></svg>');
        }
        .callout-warning::after {
            background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="%23d97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5 22 20H2z"/><path d="M12 10v4"/><path d="M12 17.2v.1"/></svg>');
        }
        .callout-danger::after {
            background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="%23dc2626" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M15 9l-6 6"/><path d="M9 9l6 6"/></svg>');
        }
        blockquote > :first-child, .callout > :first-child { margin-top: 0; }
        blockquote > :last-child, .callout > :last-child { margin-bottom: 0; }
        article pre { background: #f4f4f5; padding: 12px; border-radius: 6px; overflow-x: auto; }
        article code { background: #f4f4f5; padding: 1px 5px; border-radius: 4px; font-size: 90%; }
        article pre code { background: none; padding: 0; }
        .links a { color: #3f3f46; }
        @media (prefers-color-scheme: dark) {
            /* Dracula's own pink, so a link and the code theme agree */
            :root { --link: #ff79c6; }
            body { background: #18181b; color: #e4e4e7; }
            .card { background: #27272a; }
            input[type=text], input[type=password] { background: #18181b; border-color: #3f3f46; }
            .links a { color: #a1a1aa; }
            .post-summary { border-bottom-color: #3f3f46; }
            article pre, article code { background: #18181b; }
            .tag, .tag:visited { background: #3f3f46; color: #e4e4e7; }
            .sidebar .block { background: #27272a; }
            .block-title { color: #a1a1aa; }
        }
    </style>
</head>
<body>
<header>
    <a class="brand" href="<?= esc_attr(route_url('/')) ?>">
        <?php if (!empty($site_logo)): ?>
            <img class="logo" src="<?= esc_attr($site_logo) ?>" alt="<?= esc_attr($site_name ?? '') ?>">
        <?php else: ?>
            <strong><?= esc_html($site_name ?? '') ?></strong>
        <?php endif ?>
    </a>
    <?= $main_menu ?? '' ?>
    <?php // whatever else was put in this place. A place is one idea: if the editor offers `main`
          // and the admin lists a table for it, then what somebody puts there has to render, or
          // the promise is only true for menus. ?>
    <?= isset($places) ? $places->blocks('main') : '' ?>
    <span class="spacer"></span>
    <?php if (!empty($current_user)): ?>
        <a href="<?= esc_attr(route_url('/profile')) ?>"><?= esc_html($current_user->name() ?: 'Profile') ?></a>
        <form method="post" action="<?= esc_attr(route_url('/logout')) ?>">
            <button type="submit">Log out</button>
        </form>
    <?php else: ?>
        <a href="<?= esc_attr(route_url('/login')) ?>">Log in</a>
        <?php if (!empty($registration_open)): ?>
            <a href="<?= esc_attr(route_url('/register')) ?>">Register</a>
        <?php endif ?>
    <?php endif ?>
</header>
<?php
// what the site has put beside the content, if anything. Asked for once, here, so the layout can
// leave the whole column out rather than render an empty one - a sidebar with nothing in it is a
// hole in the design at every width.
$sidebar = isset($places) ? $places->render('sidebar') : '';
?>
<main class="wide<?= $sidebar === '' ? '' : ' has-sidebar' ?>">
    <div class="card">
        <?= $this->block('content') ?>
    </div>
    <?php if ($sidebar !== ''): ?>
        <aside class="sidebar"><?= $sidebar ?></aside>
    <?php endif ?>
</main>
</body>
</html>
