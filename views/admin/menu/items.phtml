<?php
/**
 * The items of one menu
 *
 * Server rendered rather than a dynamic list: this is a tree somebody is rearranging, not a table
 * somebody is searching, and the indent is the point of the screen.
 */
?>
<?php $this->useLayout($admin_layout) ?>
<?php $this->startBlock('content') ?>
    <div class="page-head">
        <h1><?= esc_html($menu->name) ?></h1>
        <span class="spacer"></span>
        <?php if (!empty($can_edit)): ?>
            <a class="button primary" href="<?= esc_attr($new_url) ?>">Add item</a>
        <?php endif ?>
        <a class="button" href="<?= esc_attr($back_url) ?>">Back</a>
    </div>

    <div class="panel">
        <?php if (empty($items)): ?>
            <p class="form-description">This menu has no items yet.</p>
        <?php else: ?>
            <?php // `data-sortable-tree` is the endpoint a drop posts to, and the rows carry the
                  // tree itself - id, parent, depth - because that is all the dragging reads.
                  // Position is not a column any more: a number somebody edits to reorder a list
                  // is a worse way of saying the same thing than moving the row. ?>
            <table class="plain menu-items"<?= !empty($can_edit) ? ' data-sortable-tree="'.esc_attr($move_url).'"' : '' ?>>
                <thead>
                    <tr><th class="drag-column"></th><th>Label</th><th>Points at</th><th></th></tr>
                </thead>
                <tbody>
                <?php foreach ($items as $item): ?>
                    <tr<?= $item['url'] === null ? ' class="broken"' : '' ?>
                        data-id="<?= esc_attr((string)$item['id']) ?>"
                        data-parent="<?= esc_attr((string)($item['parent_id'] ?? '')) ?>"
                        data-depth="<?= esc_attr((string)$item['depth']) ?>">
                        <td class="drag-column">
                            <?php if (!empty($can_edit)): ?>
                                <button type="button" class="action drag" data-drag-handle
                                        title="Drag to reorder" aria-label="Drag to reorder"><?= $drag_icon ?></button>
                            <?php endif ?>
                        </td>
                        <td data-tree-label style="padding-left: <?= esc_attr((string)(14 + $item['depth'] * 22)) ?>px">
                            <?= esc_html($item['label']) ?>
                        </td>
                        <td>
                            <?= esc_html($item['target']) ?>
                            <?php if ($item['url'] === null): ?>
                                <small class="form-error">not rendered - its target is gone</small>
                            <?php endif ?>
                        </td>
                        <td class="actions-column">
                            <?php // the same two icons the dynamic lists use, rendered by the
                                  // controller for the same reason: an icon is markup that is
                                  // ours, and no template builds one out of a request ?>
                            <?php if (!empty($can_edit)): ?>
                                <a class="action edit" href="<?= esc_attr($item['edit_url']) ?>"
                                   title="Edit" aria-label="Edit"><?= $edit_icon ?></a>
                                <button type="button" class="action delete" title="Delete" aria-label="Delete"
                                        onclick="Dpress.post(<?= esc_attr(json_encode($item['delete_url'])) ?>, 'Delete this item? Its children move up one level.')"><?=
                                    $delete_icon ?></button>
                            <?php endif ?>
                        </td>
                    </tr>
                <?php endforeach ?>
                </tbody>
            </table>
        <?php endif ?>
    </div>
<?php $this->endBlock() ?>
