<?php
/**
 * The admin chrome
 *
 * Its own layout rather than the site's: an editor's screen and a visitor's page want different
 * things, and a theme that restyles the front end should not be able to break the way in.
 *
 * `data-media-endpoint` is on the body so a media picker on any screen knows where the library
 * is without every template repeating it.
 */
use Dynart\Dpress\Controller\Admin\AssetController;
?>
<!DOCTYPE html>
<html lang="<?= esc_attr($locale ?? 'en') ?>">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title><?= esc_html(($title ?? 'Admin').' – '.($site_name ?? 'dpress')) ?></title>
    <?php if (!empty($site_icon)): ?>
        <link rel="icon" href="<?= esc_attr($site_icon) ?>">
        <link rel="apple-touch-icon" href="<?= esc_attr($site_icon) ?>">
    <?php endif ?>
    <link rel="stylesheet" href="<?= esc_attr(AssetController::url('admin.css')) ?>">
    <?php // deferred, so they run in order and finish before DOMContentLoaded - which is what an
          // inline `Dpress.list(...)` further down the page waits for ?>
    <script src="<?= esc_attr(AssetController::url('dynamic-list.js')) ?>" defer></script>
    <script src="<?= esc_attr(AssetController::url('admin.js')) ?>" defer></script>
</head>
<body class="admin" data-media-endpoint="<?= esc_attr(route_url('/admin/media/list')) ?>">

<header class="admin-header">
    <div class="admin-header-inner">
        <?php // dpress's own logo, always - the admin is dpress, whoever the site belongs to, and
              // `site_logo` is the site's own mark for its own pages. The name stays next to it,
              // because "which site am I in" is a question anybody running two of them has. ?>
        <a class="brand" href="<?= esc_attr(route_url('/admin')) ?>">
            <img src="<?= esc_attr(AssetController::url('logo.svg')) ?>" alt="dpress">
        </a>
        <span class="site"><?= esc_html($site_name ?? '') ?></span>
        <a href="<?= esc_attr(route_url('/')) ?>">View site</a>
        <span class="spacer"></span>
        <?php if (!empty($current_user)): ?>
            <a href="<?= esc_attr(route_url('/profile')) ?>"><?= esc_html($current_user->name() ?: 'Profile') ?></a>
            <form method="post" action="<?= esc_attr(route_url('/logout')) ?>">
                <button type="submit">Log out</button>
            </form>
        <?php endif ?>
    </div>
</header>

<div class="admin-body">
    <nav class="admin-nav" aria-label="Admin sections">
        <?php foreach (($admin_nav ?? []) as $section): ?>
            <?php // `icon` is inline SVG the controller rendered - markup, like a row action's,
                  // and ours rather than anything that came in with a request.
                  // The title names the section when the rail is too narrow for the label. ?>
            <a href="<?= esc_attr($section['url']) ?>" title="<?= esc_attr($section['label']) ?>"<?=
                $section['key'] === ($admin_section ?? '') ? ' class="current" aria-current="page"' : '' ?>>
                <?= $section['icon'] ?>
                <span class="label"><?= esc_html($section['label']) ?></span>
            </a>
        <?php endforeach ?>
    </nav>

    <main class="admin-main<?= !empty($narrow) ? ' narrow' : '' ?>">
        <?php if (!empty($notice)): ?>
            <p class="notice"><?= esc_html($notice) ?></p>
        <?php endif ?>
        <?= $this->block('content') ?>
    </main>
</div>

<?php // one hidden form per page, so a row action can POST with a CSRF token behind it ?>
<?php if (!empty($action_form)): ?>
    <form method="post" data-action-form hidden>
        <?= $action_form->fetch() ?>
    </form>
<?php endif ?>

<?= $this->block('script') ?>
</body>
</html>
