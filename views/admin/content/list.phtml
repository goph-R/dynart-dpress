<?php $this->useLayout($admin_layout) ?>
<?php $this->startBlock('content') ?>
    <div class="page-head">
        <h1><?= esc_html($title) ?></h1>
        <span class="spacer"></span>
        <?php // A button rather than a link, because it writes: "New" inserts the row the editor
              // is opened against, so that attaching a file works before the first save. Posting
              // it goes through the action form, the same as every other write on this screen. ?>
        <?php if (!empty($can_create)): ?>
            <button type="button" class="button primary"
                    onclick="Dpress.post(<?= esc_attr(json_encode($new_url)) ?>)">New</button>
        <?php endif ?>
    </div>

    <?= $this->fetch('dpress_admin:list', [
        'list_id' => $list_id,
        'list_config' => $list_config,
        'filters' => $this->fetch('dpress_admin:content/filters', ['status' => $status]),
    ]) ?>
<?php $this->endBlock() ?>
