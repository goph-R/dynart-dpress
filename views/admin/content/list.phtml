<?php $this->useLayout($admin_layout) ?>
<?php $this->startBlock('content') ?>
    <div class="page-head">
        <h1><?= esc_html($title) ?></h1>
        <span class="spacer"></span>
        <?php if (!empty($trash)): ?>
            <?= $this->fetch('dpress_admin:trash-button', $trash) ?>
        <?php endif ?>
        <?php // A button rather than a link, because it writes: "New" inserts the row the editor
              // is opened against, so that attaching a file works before the first save. Posting
              // it goes through the action form, the same as every other write on this screen. ?>
        <?php if (!empty($can_create)): ?>
            <button type="button" class="button primary with-icon"
                    onclick="Dpress.post(<?= esc_attr(json_encode($new_url)) ?>)"><?= \Dynart\Dpress\Dpress::icon('plus') ?> New</button>
        <?php endif ?>
    </div>

    <?= $this->fetch('dpress_admin:list', [
        'list_id' => $list_id,
        'list_config' => $list_config,
        'filters' => $this->fetch('dpress_admin:content/filters', [
            'status' => $status, 'category_filter' => $category_filter ?? [], 'category_id' => $category_id ?? '',
        ]),
    ]) ?>
<?php $this->endBlock() ?>
