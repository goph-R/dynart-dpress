<?php $this->useLayout($admin_layout) ?>
<?php $this->startBlock('content') ?>
    <div class="page-head">
        <h1><?= esc_html($title) ?></h1>
        <span class="spacer"></span>
        <?php // View is the page as the site serves it now, one click away - no icon, because
              // Preview has the eye and is the one somebody in an editor usually wants: it shows
              // what is in the boxes rather than what was last saved. ?>
        <?php if (!empty($view_url)): ?>
            <a class="button" href="<?= esc_attr($view_url) ?>" target="_blank" rel="noopener">View</a>
        <?php endif ?>
        <?php // A submit button for the editor form, standing outside it: `form` names the form
              // it belongs to, `formaction` sends it somewhere else and `formtarget` opens that
              // in a new tab. So the boxes travel exactly as Save would send them, with no
              // second copy of the fields and no JavaScript - and this page stays as it is. ?>
        <?php if (!empty($preview_url)): ?>
            <button type="submit" class="button with-icon" form="content-form" data-preview-cursor
                    formaction="<?= esc_attr($preview_url) ?>" formtarget="_blank"><?= \Dynart\Dpress\Dpress::icon('eye') ?> Preview</button>
        <?php endif ?>
        <?php if (!empty($history_url)): ?>
            <a class="button with-icon" href="<?= esc_attr($history_url) ?>"><?= \Dynart\Dpress\Dpress::icon('scroll') ?> History</a>
        <?php endif ?>
        <a class="button with-icon" href="<?= esc_attr($back_url) ?>" data-back><?= \Dynart\Dpress\Dpress::icon('back') ?> Back</a>
    </div>
    <div class="panel">
        <form method="post" id="content-form">
            <?= $form->fetch() ?>
        </form>

        <?php // An expandable section like the form's own, and drawn by the same template - but
              // outside the form on purpose. Attaching and detaching are immediate writes, and the
              // things in here are buttons rather than fields: nested inside the form they would
              // submit it, and their state would look like something Save is responsible for.
              //
              // There is always an id to attach to: "New" writes the row before this screen
              // renders, so this has no empty case and no "save the post first" to apologise with. ?>
        <?php if (!empty($can_attach)): ?>
            <?php ob_start() ?>
                <div class="attachments-actions">
                    <button type="button" class="button with-icon"
                            data-attach="<?= esc_attr($attachments['attach_url']) ?>"><?= \Dynart\Dpress\Dpress::icon('plus') ?> Add attachment</button>
                </div>
                <div id="<?= esc_attr($attachments['list_id']) ?>" data-attachment-list
                     data-list="<?= esc_attr(json_encode($attachments['config'], JSON_UNESCAPED_SLASHES)) ?>"></div>
            <?php $attachmentsBody = ob_get_clean() ?>
            <?= $this->fetch('dpress:form-section', [
                'label'  => 'Attachments',
                'id'     => 'attachments-section',
                'open'   => false,
                'fields' => $attachmentsBody,
            ]) ?>
        <?php endif ?>

        <?php // below the attachments, so Save is the last thing on the screen - and outside the
              // form with it, so `form` says which form it saves ?>
        <div class="form-actions">
            <a class="button" href="<?= esc_attr($back_url) ?>">Cancel</a>
            <button type="submit" class="primary with-icon" form="content-form"><?= \Dynart\Dpress\Dpress::icon('save') ?> Save</button>
        </div>
    </div>
<?php $this->endBlock() ?>
