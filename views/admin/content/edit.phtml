<?php $this->useLayout($admin_layout) ?>
<?php $this->startBlock('content') ?>
    <div class="page-head">
        <h1><?= esc_html($title) ?></h1>
        <span class="spacer"></span>
        <?php if (!empty($view_url)): ?>
            <a class="button" href="<?= esc_attr($view_url) ?>" target="_blank" rel="noopener">View</a>
        <?php endif ?>
        <?php if (!empty($history_url)): ?>
            <a class="button" href="<?= esc_attr($history_url) ?>">History</a>
        <?php endif ?>
        <a class="button" href="<?= esc_attr($back_url) ?>">Back</a>
    </div>
    <div class="panel">
        <form method="post">
            <?= $form->fetch() ?>
            <div class="form-actions">
                <button type="submit" class="primary">Save</button>
                <a class="button" href="<?= esc_attr($back_url) ?>">Cancel</a>
            </div>
        </form>
    </div>

    <?php // Outside the form on purpose. Attaching and detaching are immediate writes, and the
          // things in here are buttons rather than fields - nested inside the form they would
          // submit it, and their state would look like something Save is responsible for.
          //
          // There is always an id to attach to: "New" writes the row before this screen renders,
          // so this panel has no empty case and no "save the post first" to apologise with. ?>
    <?php if (!empty($can_attach)): ?>
        <div class="panel attachments">
            <div class="page-head">
                <h2>Attachments</h2>
                <span class="spacer"></span>
                <button type="button" class="button"
                        data-attach="<?= esc_attr($attachments['attach_url']) ?>">Add attachment</button>
            </div>
            <div id="<?= esc_attr($attachments['list_id']) ?>" data-attachment-list
                 data-list="<?= esc_attr(json_encode($attachments['config'], JSON_UNESCAPED_SLASHES)) ?>"></div>
        </div>
    <?php endif ?>
<?php $this->endBlock() ?>
