<?php $this->useLayout($admin_layout) ?>
<?php $this->startBlock('content') ?>
    <div class="page-head">
        <h1>History</h1>
        <span class="spacer"></span>
        <a class="button" href="<?= esc_attr($back_url) ?>">Back</a>
    </div>
    <p class="breadcrumb"><?= esc_html($content->title) ?></p>
    <div class="panel">
        <?php if (empty($revisions)): ?>
            <p class="form-description">No revisions recorded yet.</p>
        <?php else: ?>
            <table class="plain">
                <thead>
                    <tr><th>When</th><th>What</th><th>Title</th><th>Status</th></tr>
                </thead>
                <tbody>
                <?php // `rev_at` and `rev_type`, which is what `revisions()` selects. It said
                      // `changed_at` and `operation`, so When and What were blank on every
                      // history screen there has ever been - the same two names the dashboard
                      // had wrong, in the same way, found the same way: by somebody looking. ?>
                <?php foreach ($revisions as $revision): ?>
                    <tr>
                        <td><?= esc_html(substr((string)($revision['rev_at'] ?? ''), 0, 16)) ?></td>
                        <td><?= esc_html((string)($revision['rev_type'] ?? '')) ?></td>
                        <td><?= esc_html((string)($revision['title'] ?? '')) ?></td>
                        <td><?= esc_html((string)($revision['status'] ?? '')) ?></td>
                    </tr>
                <?php endforeach ?>
                </tbody>
            </table>
        <?php endif ?>
    </div>
<?php $this->endBlock() ?>
