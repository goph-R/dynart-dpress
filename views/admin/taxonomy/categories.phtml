<?php
/**
 * The category tree
 *
 * Server rendered rather than a dynamic list, and for the same reason the menu items screen is:
 * this is a tree somebody is arranging, not a table somebody is searching, and the indent is the
 * point of the screen. Dragging a row cannot mean anything while the rows are sorted by name or
 * split across pages, so the search box, the sortable columns and the pager went with the change.
 */
?>
<?php $this->useLayout($admin_layout) ?>
<?php $this->startBlock('content') ?>
    <div class="page-head">
        <h1>Categories</h1>
        <span class="spacer"></span>
        <a class="button" href="<?= esc_attr($tags_url) ?>">Tags</a>
        <?php if (!empty($can_create)): ?>
            <a class="button primary" href="<?= esc_attr($new_url) ?>">New</a>
        <?php endif ?>
    </div>

    <div class="panel">
        <?= $this->fetch('dpress_admin:tree', [
            'rows'       => $categories,
            'columns'    => $columns,
            'rowActions' => $row_actions,
            'move_url'   => $move_url,
            'drag_icon'  => $drag_icon,
            'empty'      => 'No categories yet.',
        ]) ?>
    </div>
<?php $this->endBlock() ?>
