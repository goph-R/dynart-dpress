<?php
/**
 * The category tree
 *
 * Server rendered rather than a dynamic list, and for the same reason the menu items screen is:
 * this is a tree somebody is arranging, not a table somebody is searching, and the indent is the
 * point of the screen. Dragging a row cannot mean anything while the rows are sorted by name or
 * split across pages, so the search box, the sortable columns and the pager went with the change.
 */
?>
<?php $this->useLayout($admin_layout) ?>
<?php $this->startBlock('content') ?>
    <div class="page-head">
        <h1>Categories</h1>
        <span class="spacer"></span>
        <a class="button" href="<?= esc_attr($tags_url) ?>">Tags</a>
        <?php if (!empty($can_create)): ?>
            <a class="button primary" href="<?= esc_attr($new_url) ?>">New</a>
        <?php endif ?>
    </div>

    <div class="panel">
        <?php if (empty($categories)): ?>
            <p class="form-description">No categories yet.</p>
        <?php else: ?>
            <table class="plain menu-items"<?= !empty($can_edit) ? ' data-sortable-tree="'.esc_attr($move_url).'"' : '' ?>>
                <thead>
                    <tr><th class="drag-column"></th><th>Name</th><th>Slug</th><th></th></tr>
                </thead>
                <tbody>
                <?php foreach ($categories as $category): ?>
                    <tr data-id="<?= esc_attr((string)$category['id']) ?>"
                        data-parent="<?= esc_attr((string)($category['parent_id'] ?? '')) ?>"
                        data-depth="<?= esc_attr((string)$category['depth']) ?>">
                        <td class="drag-column">
                            <?php if (!empty($can_edit)): ?>
                                <button type="button" class="action drag" data-drag-handle
                                        title="Drag to reorder" aria-label="Drag to reorder"><?= $drag_icon ?></button>
                            <?php endif ?>
                        </td>
                        <td data-tree-label style="padding-left: <?= esc_attr((string)(14 + $category['depth'] * 22)) ?>px">
                            <?php if (!empty($can_edit)): ?>
                                <a href="<?= esc_attr($category['edit_url']) ?>"><?= esc_html($category['name']) ?></a>
                            <?php else: ?>
                                <?= esc_html($category['name']) ?>
                            <?php endif ?>
                        </td>
                        <td><?= esc_html($category['slug']) ?></td>
                        <td class="actions-column">
                            <?php if (!empty($can_edit)): ?>
                                <a class="action edit" href="<?= esc_attr($category['edit_url']) ?>"
                                   title="Edit" aria-label="Edit"><?= $edit_icon ?></a>
                            <?php endif ?>
                            <?php if (!empty($can_delete)): ?>
                                <button type="button" class="action delete" title="Delete" aria-label="Delete"
                                        onclick="Dpress.post(<?= esc_attr(json_encode($category['delete_url'])) ?>, 'Delete this category? Its children move up one level, and the posts in it keep their other categories.')"><?= $delete_icon ?></button>
                            <?php endif ?>
                        </td>
                    </tr>
                <?php endforeach ?>
                </tbody>
            </table>
        <?php endif ?>
    </div>
<?php $this->endBlock() ?>
