<?php
/**
 * A Ko-fi button
 *
 * The colour is inline because it belongs to this one block - a class cannot carry a value
 * somebody typed - and `KofiBlock::color()` validated it as six hex digits, so what goes in here
 * cannot be a declaration of its own.
 *
 * `rel="noopener"` on a link that opens elsewhere, and the cup is `aria-hidden` with the words
 * beside it doing the announcing: "image, Ko-fi, link, Buy me a coffee" says it twice.
 */
?>
<?php // markdown, rendered when the block was saved - a `div` and not a `p`, because what
      // comes back already has paragraphs of its own ?>
<?php if ($description !== ''): ?>
    <div class="kofi-description"><?= $description ?></div>
<?php endif ?>
<a class="kofi-button" href="<?= esc_attr($url) ?>" target="_blank" rel="noopener"
   style="background: <?= esc_attr($color) ?>; color: <?= esc_attr($ink) ?>;">
    <img class="kofi-cup" src="<?= esc_attr($icon) ?>" alt="" aria-hidden="true"
         width="20" height="14" loading="lazy">
    <span><?= esc_html($text) ?></span>
</a>
