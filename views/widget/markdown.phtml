<?php
/**
 * The markdown field: a textarea, deliberately not an editor
 *
 * `admin.js` binds anything matching `textarea.markdown-editor`, so the class is not decoration -
 * it is the binding, and it is what `markdown-highlight.js` paints its colours behind. Neither
 * of them changes the value: with the scripts off this is a textarea and the field still works.
 *
 * `attributes` is where the content builder puts `data-insert-media`, which is what grows the one
 * button the field has.
 *
 * **No browser text assistance.** `spellcheck` is off because this is source and not prose: a
 * dictionary flags every fenced identifier, every slug and every URL word, and under a coloured
 * field the underlines sit on a layer of their own. `autocorrect` is off for a harder reason -
 * it *changes what was typed*, and a field whose value is anything other than exactly what the
 * author typed is the one thing this whole editor is built not to be.
 */
$id = $form->idByNameAndField($name, $field);
?>
<textarea id="<?= $id ?>" name="<?= $form->inputName($name) ?>" class="markdown-editor" rows="26" spellcheck="false" autocorrect="off"<?= esc_attrs($field['attributes'] ?? []) ?>><?= $form->value($name, true) ?></textarea>
