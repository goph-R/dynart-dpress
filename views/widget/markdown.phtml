<?php
/**
 * The markdown field: a textarea with an editor's comforts, and never more than a textarea under them
 *
 * Colours, line numbers, a wrap column with a dotted line, Tab and Shift+Tab, a smart Home, full
 * size - and still a `<textarea>` holding exactly what was typed. Nothing replaces it and nothing
 * rewrites it: the colours and the numbers are drawn on a backdrop behind it, the rest is keys
 * and padding. `admin.js` binds anything matching `textarea.markdown-editor`, so the class is not
 * decoration - it is the binding, and it is what `markdown-highlight.js` paints behind. With the
 * scripts off this is a plain textarea and the field still works.
 *
 * `attributes` is where the content builder puts `data-insert-media`, which is what grows the one
 * button the field has.
 *
 * **The lines are numbered**, in a gutter on the left - a wrapped line keeps one number, on its
 * first row, so wrapping and numbering go together. `'numbers' => false` for a field without.
 *
 * **`'wrap' => false`** only sets where the *Wrap text* box starts, the first time: after that it
 * is as this browser last left it (`admin.js`).
 *
 * **No browser text assistance.** `spellcheck` is off because this is source and not prose: a
 * dictionary flags every fenced identifier, every slug and every URL word, and under a coloured
 * field the underlines sit on a layer of their own. `autocorrect` is off for a harder reason -
 * it *changes what was typed*, and a field whose value is anything other than exactly what the
 * author typed is the one thing this whole editor is built not to be.
 */
$id = $form->idByNameAndField($name, $field);
$noWrap = ($field['wrap'] ?? true) === false;
$numbered = ($field['numbers'] ?? true) !== false;
?>
<textarea id="<?= $id ?>" name="<?= $form->inputName($name) ?>" class="markdown-editor<?= $noWrap ? ' no-wrap' : '' ?><?= $numbered ? ' numbered' : '' ?>" rows="26" spellcheck="false" autocorrect="off"<?= $noWrap ? ' wrap="off"' : '' ?><?= esc_attrs($field['attributes'] ?? []) ?>><?= $form->value($name, true) ?></textarea>
