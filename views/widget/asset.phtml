<?php
/**
 * A path to a file the site is branded with, typed or picked
 *
 * **The value is a path, not a media id**, which is the whole point of it being its own widget
 * rather than `media`. A header logo is chrome: it renders on pages that show no content at all,
 * it has to work before anything has been uploaded, and deleting a library item must not be able
 * to take the header down with it. `Setting::SITE_LOGO` says so in as many words.
 *
 * So the field stays a text input - `/static/logo.svg` is still typeable, and so is a URL on
 * another host - and the picker is a second way to fill it, writing the chosen file's
 * site-relative path. `admin.js` finds the field by `data-asset-field` and the pieces inside it
 * by their own attributes.
 */
$id = $form->idByNameAndField($name, $field);
$value = (string)$form->value($name);
?>
<div class="asset-field" data-asset-field>
    <?php // resolved by the builder, because turning a stored path into a URL is `siteAsset()`'s
          // job and a template has no business knowing about `app.base_url`. The picker replaces
          // it with the URL of whatever was chosen. ?>
    <div class="asset-field-preview" data-asset-preview>
        <?php if ($value !== '' && !empty($field['preview'])): ?>
            <img src="<?= esc_attr($field['preview']) ?>" alt="">
        <?php endif ?>
    </div>
    <input type="text" id="<?= $id ?>" name="<?= $form->inputName($name) ?>"
           value="<?= esc_attr($value) ?>" data-asset-input>
    <button type="button" class="button small" data-asset-pick>Choose…</button>
    <button type="button" class="button small" data-asset-clear<?= $value === '' ? ' hidden' : '' ?>>Remove</button>
</div>
