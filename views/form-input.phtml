<?php
/**
 * The CMS field types. Anything else falls through to the framework's own partial, so the
 * ordinary inputs are not duplicated here.
 */
$id = $form->idByNameAndField($name, $field);
$inputName = $form->inputName($name);
$type = $field['type'] ?? 'text';
$attrs = $field['attributes'] ?? [];
?>
<?php if ($type == 'markdown'): ?>
    <textarea id="<?= $id ?>" name="<?= $inputName ?>" class="markdown-editor" rows="18"<?= esc_attrs($attrs) ?>><?= $form->value($name, true) ?></textarea>

<?php elseif ($type == 'media'): ?>
    <?php $value = (string)$form->value($name) ?>
    <div class="media-field" data-media-field>
        <input type="hidden" id="<?= $id ?>" name="<?= $inputName ?>" value="<?= esc_attr($value) ?>" data-media-input>
        <div class="media-field-preview" data-media-preview>
            <?php if ($value !== '' && !empty($media_preview)): ?><?= $media_preview ?><?php endif ?>
        </div>
        <button type="button" class="button small" data-media-pick>Choose…</button>
        <button type="button" class="button small" data-media-clear<?= $value === '' ? ' hidden' : '' ?>>Remove</button>
    </div>

<?php elseif ($type == 'checkboxes'): ?>
    <?php $selected = (array)($form->values()[$name] ?? []) ?>
    <div class="checkbox-list">
        <?php foreach (($field['options'] ?? []) as $optionValue => $optionLabel): ?>
            <label>
                <input type="checkbox" name="<?= $inputName ?>[]" value="<?= esc_attr($optionValue) ?>"
                    <?= in_array((string)$optionValue, array_map('strval', $selected)) ? ' checked' : '' ?>>
                <?= esc_html($optionLabel) ?>
            </label>
        <?php endforeach ?>
        <?php if (empty($field['options'])): ?><p class="form-description">None yet.</p><?php endif ?>
    </div>

<?php elseif ($type == 'permissions'): ?>
    <?php $selected = array_map('strval', (array)($form->values()[$name] ?? [])) ?>
    <div class="permission-groups">
        <?php foreach (($field['groups'] ?? []) as $group => $permissions): ?>
            <fieldset>
                <legend><?= esc_html(ucfirst($group)) ?></legend>
                <?php foreach ($permissions as $permission): ?>
                    <label>
                        <input type="checkbox" name="<?= $inputName ?>[]" value="<?= esc_attr($permission) ?>"
                            <?= in_array($permission, $selected) ? ' checked' : '' ?>>
                        <code><?= esc_html($permission) ?></code>
                    </label>
                <?php endforeach ?>
            </fieldset>
        <?php endforeach ?>
    </div>

<?php else: ?>
    <?= $this->fetch('micro:form-input', ['form' => $form, 'name' => $name, 'field' => $field]) ?>
<?php endif ?>
